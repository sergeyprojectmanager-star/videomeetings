# Copy to .env to override the defaults used by docker-compose.yml
POSTGRES_USER=video_meetings
POSTGRES_PASSWORD=video_meetings
POSTGRES_DB=video_meetings
POSTGRES_PORT=5432

# Connection string for the api app
DATABASE_URL=postgresql://video_meetings:video_meetings@localhost:5432/video_meetings

# Secret used to sign JWT access tokens (HS256) in the api app; required.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
